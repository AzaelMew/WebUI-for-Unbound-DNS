[Unit]
Description=Unbound DNS WebUI (audited local deployment)
After=network-online.target unbound.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/unbound-webui
ExecStart=/opt/unbound-webui/venv/bin/python /opt/unbound-webui/run.py
Restart=on-failure
RestartSec=3
UMask=0077
Environment=PYTHONUNBUFFERED=1
Environment=OTEL_SDK_DISABLED=true
Environment=DO_NOT_TRACK=1
ProtectSystem=strict
ReadWritePaths=/opt/unbound-webui /etc/unbound
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_DAC_OVERRIDE CAP_CHOWN
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target
